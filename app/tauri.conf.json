{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warcry",
  "mainBinaryName": "Warcry",
  "identifier": "com.stackout.warcry",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Warcry",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "backgroundColor": "#0d0618"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Voice commands for games and apps",
    "longDescription": "Speak, and Warcry presses the keys. Offline voice commands for games and apps.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "../macos/warcry.entitlements",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libasound2", "libxtst6", "libxi6"]
      }
    }
  }
}
